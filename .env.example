# ========================================================
# 骗子酒馆 (Liar's Bar) - 服务器部署配置示例
# 复制此文件为 .env 并根据需要修改：cp .env.example .env
# ========================================================

# 宿主机映射端口 (默认 9527，可改为 80、8080 等)
PORT=9527

# 私密进服暗号 / 口令 (防蹭服核心配置)
# - 若留空：酒馆对所有人开放
# - 若设置（例如 SERVER_ACCESS_KEY=my_secret_code）：只有输入正确暗号的玩家能进入对局，陌生人无法接入
SERVER_ACCESS_KEY=

# 公网标记
IS_PUBLIC_CLOUD=true
