# ========================================================
# 骗子酒馆 (Liar's Bar) - 服务器部署配置示例
# 复制此文件为 .env 并根据需要修改：cp .env.example .env
# ========================================================

# 宿主机映射端口 (默认 9527，可改为 80、8080 等)
PORT=9527

# 私密进服暗号 / 口令 (防蹭服核心配置)
# - 若留空：酒馆对所有人开放
# - 若设置（例如 SERVER_ACCESS_KEY=my_secret_code）：只有输入正确暗号的玩家能进入对局，陌生人无法接入
SERVER_ACCESS_KEY=

# 公网标记 (决定多房间开关与旧客户端抢房防护的默认值)
IS_PUBLIC_CLOUD=true

# ---------------- 多房间（P0）----------------
# 多房间总开关：IS_PUBLIC_CLOUD=true 时默认开启，无需显式设置
# MULTI_ROOM_ENABLED=true
# 全服房间数上限 / 单 IP 建房上限
# MAX_ROOMS=500
# MAX_ROOMS_PER_IP=20
# 空房回收 / 对局全员掉线回收 (毫秒)
# ROOM_EMPTY_TTL_MS=1800000
# ROOM_ABANDON_TTL_MS=7200000

# ---------------- 安全（P1）----------------
# 房间密码：无需服务器配置——房主建房时在界面上自行设置（每个房间独立）
# 旧客户端自报房主防护：公网默认关闭（ALLOW_LEGACY_HOST_CLAIM=false），如需兼容旧 APK 抢 MAIN 房可显式开启
# ALLOW_LEGACY_HOST_CLAIM=false
# 房主异地恢复校验：公网默认开启（换网络后需重新入座）
# HOST_RESUME_SAME_IP_ONLY=true
# 单连接消息速率 (次/秒，突发 20)
# RATE_LIMIT_PER_SEC=10
# 单帧大小上限 (字节)
# WS_MAX_PAYLOAD_BYTES=65536

# ---------------- 可观测性（P1）----------------
# 指标接口 /api/metrics：默认关闭；开启后建议配合 SERVER_ACCESS_KEY 鉴权（?key=xxx）
# METRICS_ENABLED=true
